.skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg,
            transparent 0%,
            rgba(255, 255, 255, 0.04) 20%,
            rgba(255, 255, 255, 0.08) 50%,
            rgba(255, 255, 255, 0.04) 80%,
            transparent 100%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.8s ease infinite;
}

